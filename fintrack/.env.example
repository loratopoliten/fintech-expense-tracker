# Copy to .env and fill in values

# SQLite (default, no setup needed for local dev)
# DATABASE_URL=db/fintrack.db

# Supabase PostgreSQL (for production — CapitalPyre deploy method)
# DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
# DATABASE_URL=postgres://postgres:[password]@db.[ref].supabase.co:5432/postgres

# JWT secret — generate a long random string for production
JWT_SECRET=change-me-in-production

# Comma-separated origins for deployed frontends. Use * only for local/API-only testing.
CORS_ORIGINS=*

# App settings
PORT=8000
