# ── Local dev (SQLite — no setup needed) ──────────────────
# Leave DATABASE_URL unset to use SQLite automatically

# ── Production (Supabase PostgreSQL) ──────────────────────
# DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
# Also works with postgres:// prefix (Railway sometimes uses this format):
# DATABASE_URL=postgres://postgres:[password]@db.[ref].supabase.co:5432/postgres

# ── JWT Secret (change this in production!) ───────────────
JWT_SECRET=change-me-to-a-long-random-string

# ── CORS origins ──────────────────────────────────────────
# Comma-separated origins for deployed frontends. Use * only for local/API-only testing.
CORS_ORIGINS=*

# ── Port ─────────────────────────────────────────────────
PORT=8000
